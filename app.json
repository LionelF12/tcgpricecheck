{
  "expo": {
    "name": "TCG Price Check",
    "slug": "tcgpricecheck",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tcgpricecheck",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.noonoocollectibles.tcgpricecheck",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to photograph trading cards for identification and price lookup.",
        "NSPhotoLibraryUsageDescription": "Used to select photos of trading cards for identification.",
        "NSPhotoLibraryAddUsageDescription": "Used to save card images to your photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F1117",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F1117"
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Used to photograph trading cards for price lookup."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to select trading card photos for price lookup."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Used to save card images to your photo library.",
          "savePhotosPermission": "Allow saving card images."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
